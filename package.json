{
  "name": "product-os",
  "private": true,
  "version": "0.1.0",
  "description": "Ground — structured product memory for AI coding agents",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @product-os/web dev",
    "dev:web": "pnpm --filter @product-os/web dev",
    "build": "turbo build",
    "clean": "turbo clean && rm -rf node_modules",
    "typecheck": "turbo typecheck",
    "db:setup": "psql \"$DATABASE_URL\" -f packages/ground/schema.sql",
    "db:seed": "node packages/ground/seed.mjs"
  },
  "devDependencies": {
    "turbo": "^2.8.20"
  }
}
