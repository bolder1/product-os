# Postgres. From Supabase: Project settings → Database → Connection string (URI).
# Use the Session pooler string — Vercel is IPv4 and Supabase direct is IPv6-only.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.rrlucptglwektlofolej.supabase.co:5432/postgres

# Public origin, used to build the MCP connect command shown in the app.
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Invite code required to create an account.
#   set    → signup requires this exact code
#   unset  → open under `next dev` only; CLOSED in any production build,
#            including `next start` locally. Forgetting to set this on a
#            deployment disables signup rather than leaving it wide open.
GROUND_INVITE_CODE=
