{
  "id": "tpl_design_system",
  "name": "Design System Starter",
  "description": "Comprehensive design system with tokens (colors, typography, spacing, shadows), 12 base components with variants, and documentation pages.",
  "category": "design_system",
  "tags": ["design-system", "tokens", "components", "typography", "colors", "documentation"],
  "version": "1.0.0",
  "author": "Product OS",
  "compatibility": "0.1.0",
  "variables": [
    { "key": "systemName", "label": "Design System Name", "type": "text", "default": "Acme DS" },
    { "key": "primaryColor", "label": "Primary Color", "type": "color", "default": "#3B82F6" },
    { "key": "secondaryColor", "label": "Secondary Color", "type": "color", "default": "#8B5CF6" },
    { "key": "fontFamily", "label": "Font Family", "type": "text", "default": "Inter" }
  ],
  "nodes": [
    { "templateId": "mod_tokens", "kind": "module", "label": "Design Tokens", "data": { "description": "Foundation tokens — colors, typography, spacing, shadows, motion", "priority": "high" } },
    { "templateId": "mod_primitives", "kind": "module", "label": "Primitive Components", "data": { "description": "Base UI building blocks — buttons, inputs, badges, cards", "priority": "high" } },
    { "templateId": "mod_composites", "kind": "module", "label": "Composite Components", "data": { "description": "Higher-order patterns — forms, modals, navigation, data tables", "priority": "medium" } },
    { "templateId": "mod_docs", "kind": "module", "label": "Documentation", "data": { "description": "Usage guidelines, principles, and contribution docs", "priority": "medium" } },

    { "templateId": "token_primary", "kind": "token", "label": "Primary", "data": { "namespace": "color", "tokenType": "color", "value": "{{primaryColor}}", "semanticAlias": "color-primary" } },
    { "templateId": "token_secondary", "kind": "token", "label": "Secondary", "data": { "namespace": "color", "tokenType": "color", "value": "{{secondaryColor}}", "semanticAlias": "color-secondary" } },
    { "templateId": "token_bg", "kind": "token", "label": "Background", "data": { "namespace": "color", "tokenType": "color", "value": "#060918", "semanticAlias": "color-bg-primary" } },
    { "templateId": "token_surface", "kind": "token", "label": "Surface", "data": { "namespace": "color", "tokenType": "color", "value": "#0C1024", "semanticAlias": "color-bg-secondary" } },
    { "templateId": "token_text", "kind": "token", "label": "Text Primary", "data": { "namespace": "color", "tokenType": "color", "value": "#F1F5F9", "semanticAlias": "color-text-primary" } },
    { "templateId": "token_text_muted", "kind": "token", "label": "Text Muted", "data": { "namespace": "color", "tokenType": "color", "value": "#94A3B8", "semanticAlias": "color-text-secondary" } },
    { "templateId": "token_border", "kind": "token", "label": "Border", "data": { "namespace": "color", "tokenType": "color", "value": "rgba(255,255,255,0.08)", "semanticAlias": "color-border" } },
    { "templateId": "token_success", "kind": "token", "label": "Success", "data": { "namespace": "color", "tokenType": "color", "value": "#10B981", "semanticAlias": "color-success" } },
    { "templateId": "token_error", "kind": "token", "label": "Error", "data": { "namespace": "color", "tokenType": "color", "value": "#F43F5E", "semanticAlias": "color-error" } },
    { "templateId": "token_warning", "kind": "token", "label": "Warning", "data": { "namespace": "color", "tokenType": "color", "value": "#F59E0B", "semanticAlias": "color-warning" } },
    { "templateId": "token_font_family", "kind": "token", "label": "Font Family", "data": { "namespace": "typography", "tokenType": "fontFamily", "value": "{{fontFamily}}", "semanticAlias": "font-sans" } },
    { "templateId": "token_font_mono", "kind": "token", "label": "Font Mono", "data": { "namespace": "typography", "tokenType": "fontFamily", "value": "JetBrains Mono", "semanticAlias": "font-mono" } },
    { "templateId": "token_font_size_sm", "kind": "token", "label": "Font Size SM", "data": { "namespace": "typography", "tokenType": "fontSize", "value": "0.875rem", "semanticAlias": "text-sm" } },
    { "templateId": "token_font_size_base", "kind": "token", "label": "Font Size Base", "data": { "namespace": "typography", "tokenType": "fontSize", "value": "1rem", "semanticAlias": "text-base" } },
    { "templateId": "token_font_size_lg", "kind": "token", "label": "Font Size LG", "data": { "namespace": "typography", "tokenType": "fontSize", "value": "1.125rem", "semanticAlias": "text-lg" } },
    { "templateId": "token_font_size_xl", "kind": "token", "label": "Font Size XL", "data": { "namespace": "typography", "tokenType": "fontSize", "value": "1.25rem", "semanticAlias": "text-xl" } },
    { "templateId": "token_font_size_2xl", "kind": "token", "label": "Font Size 2XL", "data": { "namespace": "typography", "tokenType": "fontSize", "value": "1.5rem", "semanticAlias": "text-2xl" } },
    { "templateId": "token_spacing_1", "kind": "token", "label": "Spacing 1", "data": { "namespace": "spacing", "tokenType": "spacing", "value": "0.25rem", "semanticAlias": "space-1" } },
    { "templateId": "token_spacing_2", "kind": "token", "label": "Spacing 2", "data": { "namespace": "spacing", "tokenType": "spacing", "value": "0.5rem", "semanticAlias": "space-2" } },
    { "templateId": "token_spacing_4", "kind": "token", "label": "Spacing 4", "data": { "namespace": "spacing", "tokenType": "spacing", "value": "1rem", "semanticAlias": "space-4" } },
    { "templateId": "token_spacing_6", "kind": "token", "label": "Spacing 6", "data": { "namespace": "spacing", "tokenType": "spacing", "value": "1.5rem", "semanticAlias": "space-6" } },
    { "templateId": "token_spacing_8", "kind": "token", "label": "Spacing 8", "data": { "namespace": "spacing", "tokenType": "spacing", "value": "2rem", "semanticAlias": "space-8" } },
    { "templateId": "token_radius_sm", "kind": "token", "label": "Radius SM", "data": { "namespace": "border", "tokenType": "borderRadius", "value": "0.375rem", "semanticAlias": "radius-sm" } },
    { "templateId": "token_radius_md", "kind": "token", "label": "Radius MD", "data": { "namespace": "border", "tokenType": "borderRadius", "value": "0.5rem", "semanticAlias": "radius-md" } },
    { "templateId": "token_radius_lg", "kind": "token", "label": "Radius LG", "data": { "namespace": "border", "tokenType": "borderRadius", "value": "0.75rem", "semanticAlias": "radius-lg" } },
    { "templateId": "token_shadow_sm", "kind": "token", "label": "Shadow SM", "data": { "namespace": "shadow", "tokenType": "boxShadow", "value": "0 1px 2px rgba(0,0,0,0.3)", "semanticAlias": "shadow-sm" } },
    { "templateId": "token_shadow_md", "kind": "token", "label": "Shadow MD", "data": { "namespace": "shadow", "tokenType": "boxShadow", "value": "0 4px 12px rgba(0,0,0,0.25)", "semanticAlias": "shadow-md" } },

    { "templateId": "comp_button", "kind": "component", "label": "Button", "data": { "category": "primitive", "variants": ["primary", "secondary", "ghost", "destructive", "outline"], "sizes": ["sm", "md", "lg"], "states": ["default", "hover", "active", "disabled", "loading"] } },
    { "templateId": "comp_input", "kind": "component", "label": "Input", "data": { "category": "primitive", "variants": ["default", "filled", "flushed"], "sizes": ["sm", "md", "lg"], "states": ["default", "focus", "error", "disabled"] } },
    { "templateId": "comp_badge", "kind": "component", "label": "Badge", "data": { "category": "primitive", "variants": ["default", "success", "warning", "error", "info"], "sizes": ["sm", "md"] } },
    { "templateId": "comp_card", "kind": "component", "label": "Card", "data": { "category": "primitive", "variants": ["default", "elevated", "outlined", "interactive"], "slots": ["header", "body", "footer"] } },
    { "templateId": "comp_avatar", "kind": "component", "label": "Avatar", "data": { "category": "primitive", "variants": ["circle", "square"], "sizes": ["xs", "sm", "md", "lg", "xl"] } },
    { "templateId": "comp_toggle", "kind": "component", "label": "Toggle", "data": { "category": "primitive", "variants": ["default"], "sizes": ["sm", "md"], "states": ["on", "off", "disabled"] } },
    { "templateId": "comp_select", "kind": "component", "label": "Select", "data": { "category": "primitive", "variants": ["default", "multi"], "sizes": ["sm", "md", "lg"], "states": ["default", "open", "disabled"] } },
    { "templateId": "comp_tooltip", "kind": "component", "label": "Tooltip", "data": { "category": "primitive", "variants": ["dark", "light"], "positions": ["top", "bottom", "left", "right"] } },
    { "templateId": "comp_modal", "kind": "component", "label": "Modal", "data": { "category": "composite", "variants": ["default", "fullscreen", "drawer"], "slots": ["header", "body", "footer"], "sizes": ["sm", "md", "lg"] } },
    { "templateId": "comp_table", "kind": "component", "label": "Data Table", "data": { "category": "composite", "variants": ["default", "compact", "striped"], "features": ["sorting", "pagination", "selection", "search"] } },
    { "templateId": "comp_nav", "kind": "component", "label": "Navigation", "data": { "category": "composite", "variants": ["sidebar", "topbar", "breadcrumb", "tabs"], "states": ["expanded", "collapsed"] } },
    { "templateId": "comp_form", "kind": "component", "label": "Form", "data": { "category": "composite", "variants": ["default", "inline", "stepped"], "features": ["validation", "error-display", "submit-handling"] } },

    { "templateId": "page_overview", "kind": "page", "label": "Design System Overview", "data": { "publishState": "draft", "seoMetadata": { "title": "{{systemName}} — Overview" }, "sections": ["introduction", "principles", "getting-started"] } },
    { "templateId": "page_colors", "kind": "page", "label": "Colors", "data": { "publishState": "draft", "seoMetadata": { "title": "{{systemName}} — Colors" }, "sections": ["palette", "semantic-colors", "usage-guidelines"] } },
    { "templateId": "page_typography", "kind": "page", "label": "Typography", "data": { "publishState": "draft", "seoMetadata": { "title": "{{systemName}} — Typography" }, "sections": ["type-scale", "font-weights", "line-heights"] } },
    { "templateId": "page_components", "kind": "page", "label": "Components", "data": { "publishState": "draft", "seoMetadata": { "title": "{{systemName}} — Components" }, "sections": ["primitives", "composites", "patterns"] } }
  ],
  "edges": [
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_primary", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_secondary", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_bg", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_surface", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_text", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_text_muted", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_border", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_success", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_error", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_warning", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_font_family", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_font_mono", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_font_size_sm", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_font_size_base", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_font_size_lg", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_font_size_xl", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_font_size_2xl", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_spacing_1", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_spacing_2", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_spacing_4", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_spacing_6", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_spacing_8", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_radius_sm", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_radius_md", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_radius_lg", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_shadow_sm", "kind": "contains" },
    { "sourceTemplateId": "mod_tokens", "targetTemplateId": "token_shadow_md", "kind": "contains" },

    { "sourceTemplateId": "mod_primitives", "targetTemplateId": "comp_button", "kind": "contains" },
    { "sourceTemplateId": "mod_primitives", "targetTemplateId": "comp_input", "kind": "contains" },
    { "sourceTemplateId": "mod_primitives", "targetTemplateId": "comp_badge", "kind": "contains" },
    { "sourceTemplateId": "mod_primitives", "targetTemplateId": "comp_card", "kind": "contains" },
    { "sourceTemplateId": "mod_primitives", "targetTemplateId": "comp_avatar", "kind": "contains" },
    { "sourceTemplateId": "mod_primitives", "targetTemplateId": "comp_toggle", "kind": "contains" },
    { "sourceTemplateId": "mod_primitives", "targetTemplateId": "comp_select", "kind": "contains" },
    { "sourceTemplateId": "mod_primitives", "targetTemplateId": "comp_tooltip", "kind": "contains" },

    { "sourceTemplateId": "mod_composites", "targetTemplateId": "comp_modal", "kind": "contains" },
    { "sourceTemplateId": "mod_composites", "targetTemplateId": "comp_table", "kind": "contains" },
    { "sourceTemplateId": "mod_composites", "targetTemplateId": "comp_nav", "kind": "contains" },
    { "sourceTemplateId": "mod_composites", "targetTemplateId": "comp_form", "kind": "contains" },

    { "sourceTemplateId": "mod_docs", "targetTemplateId": "page_overview", "kind": "contains" },
    { "sourceTemplateId": "mod_docs", "targetTemplateId": "page_colors", "kind": "contains" },
    { "sourceTemplateId": "mod_docs", "targetTemplateId": "page_typography", "kind": "contains" },
    { "sourceTemplateId": "mod_docs", "targetTemplateId": "page_components", "kind": "contains" },

    { "sourceTemplateId": "comp_button", "targetTemplateId": "token_primary", "kind": "uses_token" },
    { "sourceTemplateId": "comp_button", "targetTemplateId": "token_radius_md", "kind": "uses_token" },
    { "sourceTemplateId": "comp_input", "targetTemplateId": "token_border", "kind": "uses_token" },
    { "sourceTemplateId": "comp_input", "targetTemplateId": "token_radius_md", "kind": "uses_token" },
    { "sourceTemplateId": "comp_badge", "targetTemplateId": "token_primary", "kind": "uses_token" },
    { "sourceTemplateId": "comp_card", "targetTemplateId": "token_surface", "kind": "uses_token" },
    { "sourceTemplateId": "comp_card", "targetTemplateId": "token_shadow_md", "kind": "uses_token" },
    { "sourceTemplateId": "comp_card", "targetTemplateId": "token_radius_lg", "kind": "uses_token" },

    { "sourceTemplateId": "page_colors", "targetTemplateId": "token_primary", "kind": "references" },
    { "sourceTemplateId": "page_typography", "targetTemplateId": "token_font_family", "kind": "references" },
    { "sourceTemplateId": "page_components", "targetTemplateId": "comp_button", "kind": "references" }
  ]
}
